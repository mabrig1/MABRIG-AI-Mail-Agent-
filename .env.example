NEXT_PUBLIC_APP_NAME=MABRIG AI Mail Agent
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin authentication
# ADMIN_PASSWORD_SHA256 is SHA-256(password), never the plaintext password.
ADMIN_EMAIL=
ADMIN_PASSWORD_SHA256=
AUTH_SECRET=
APPROVAL_SECRET=

# MABRIG Mail / BillionMail bridge
BILLIONMAIL_BASE_URL=
BILLIONMAIL_API_TOKEN=
MAIL_DOMAIN=mabrigmail.online
MAIL_HOSTNAME=mail.mabrigmail.online

# Any OpenAI-compatible AI gateway/provider can be used.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_MODEL=

# Safety / resource controls
MAX_AGENT_INPUT_CHARS=12000
